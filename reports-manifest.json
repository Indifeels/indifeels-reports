{
  "schema_version": 1,
  "manifest_version": "2026-10-08.schedule-panel.1",
  "timezone": "Australia/Melbourne",
  "policy": {
    "source_of_truth_branch": "main",
    "publish_mode": "validate_then_rebase_retry_atomic_commit",
    "preserve_last_good_on_failure": true,
    "code_owner": "Code/Claude",
    "refresh_owner": "scheduled GitHub automation operated by ChatGPT",
    "schedule_authority": "Supabase report_refresh_control + report_schedules"
  },
  "reports": [
    {
      "id": "daily",
      "title": "Daily Report",
      "workflow": "refresh-daily-monthly.yml",
      "refresh_times": [
        "schedule panel"
      ],
      "required_env": [
        "WINDSOR_API_KEY",
        "SHOPIFY_TOKEN",
        "SYNC_READ_TOKEN"
      ],
      "builders": [
        "tools/fetch_reports.py",
        "tools/reconcile_order_attribution.py",
        "tools/build.py",
        "tools/encrypt.py"
      ],
      "outputs": [
        "r/daily.bin",
        "r/daily.meta.bin"
      ],
      "supabase_sync": false,
      "schedule_control": "report_schedules"
    },
    {
      "id": "monthly",
